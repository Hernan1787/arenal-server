{
  "name": "arenal-server",
  "private": true,
  "type": "module",
  "description": "Servidor autoritativo del juego por turnos Arenal (TEC, Diseño de Software, proyecto 2)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:generate": "pnpm --filter @arenal/contracts generate",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/generated",
    "dev": "pnpm --filter @arenal/server dev",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "esbuild"
    ]
  }
}
