{
  "name": "arenal-server",
  "private": true,
  "type": "module",
  "description": "Servidor autoritativo del juego por turnos Arenal (TEC, Diseño de Software, proyecto 2)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "contracts:generate": "pnpm --filter @arenal/contracts generate && pnpm --filter @arenal/server openapi",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/generated",
    "dev": "pnpm --filter @arenal/server dev",
    "prepare": "node scripts/setup-hooks.mjs",
    "bot": "pnpm --filter @arenal/bot bot",
    "play": "pnpm --filter @arenal/bot play",
    "load": "pnpm --filter @arenal/bot load"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "esbuild",
      "protobufjs"
    ]
  }
}
