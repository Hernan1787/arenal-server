{
  "name": "@arenal/client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente de Arenal (REST y WebSocket) para el bot, el cliente de prueba y la prueba de carga.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arenal/contracts": "workspace:*",
    "@arenal/domain": "workspace:*"
  }
}
