{
  "name": "@arenal/server",
  "version": "0.3.0",
  "private": true,
  "description": "Servidor de Arenal: API REST, WebSocket y adaptadores de Postgres y Redis.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "openapi": "tsx --conditions=development scripts/generate-openapi.ts",
    "admin": "tsx --conditions=development src/cli/admin.ts"
  },
  "dependencies": {
    "@arenal/contracts": "workspace:*",
    "@arenal/domain": "workspace:*",
    "@azure/identity": "4.14.0",
    "@azure/monitor-opentelemetry": "1.20.1",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.10.0",
    "@redis/entraid": "6.3.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "redis": "6.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@readme/openapi-parser": "10.0.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}
