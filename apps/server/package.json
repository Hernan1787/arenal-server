{
  "name": "@arenal/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de Arenal: API REST, WebSocket y adaptadores de Postgres y Redis.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsx --conditions=development scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@arenal/contracts": "workspace:*",
    "@arenal/domain": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@readme/openapi-parser": "10.0.0",
    "@types/pg": "8.23.1"
  }
}
